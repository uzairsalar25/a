# =====================================================================
#  ROYAL NEWS VIDEO EDITOR — Environment Config
#  Is file ko copy karke ".env" banayein aur values bharein.
#      cp .env.example .env
#  .env ko kabhi git me commit NAHI karna (gitignore me daala hua hai).
# =====================================================================

# ---------------------------------------------------------------------
#  SUBTITLES (Transcription)
#  Default = FREE local Whisper (koi key nahi chahiye).
#  Agar aapke paas AssemblyAI key hai to neeche daal dein — code khud
#  AssemblyAI use karega, warna Whisper pe fallback ho jaayega.
# ---------------------------------------------------------------------
ASSEMBLYAI_API_KEY=
# Whisper model size: tiny | base | small | medium | large-v3
# (chhota = fast + kam accurate, bada = slow + zyada accurate)
WHISPER_MODEL=small

# ---------------------------------------------------------------------
#  TEXT-TO-SPEECH (Narration voice)
#  Default = FREE EdgeTTS (koi key nahi chahiye).
#  Voice list dekhne ke liye:  edge-tts --list-voices | grep en-
#  Energetic news-anchor style ke liye ye achhe hain:
#     en-US-GuyNeural        (male, confident)
#     en-GB-RyanNeural       (male, British)
#     en-US-ChristopherNeural(male, deep news)
# ---------------------------------------------------------------------
TTS_ENGINE=edge
EDGE_TTS_VOICE=en-US-GuyNeural
EDGE_TTS_RATE=+8%
EDGE_TTS_PITCH=+0Hz

# ---------------------------------------------------------------------
#  (OPTIONAL) AI33Pro / ElevenLabs — sirf tab jab TTS_ENGINE=ai33pro
#  Behtar quality chahiye to yahan key + voice id daalein aur upar
#  TTS_ENGINE=ai33pro kar dein.
# ---------------------------------------------------------------------
AI33PRO_API_KEY=
AI33PRO_BASE_URL=
AI33PRO_VOICE_ID=

# ---------------------------------------------------------------------
#  RENDER
#  encoder: auto | nvenc | cpu   (auto = GPU ho to NVENC, warna libx264)
# ---------------------------------------------------------------------
RENDER_ENCODER=auto
